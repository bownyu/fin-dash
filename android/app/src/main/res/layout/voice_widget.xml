<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="16dp" android:paddingEnd="12dp"
    android:paddingTop="12dp" android:paddingBottom="10dp"
    android:background="@drawable/voice_widget_background">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:id="@+id/voice_widget_body" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp"
            android:gravity="center_vertical" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/voice_widget_status" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/voice_widget_hint" android:textColor="@color/voice_widget_accent"
                    android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
                <Chronometer android:id="@+id/voice_widget_timer" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:textColor="@color/voice_widget_recording" android:textSize="12sp"
                    android:textStyle="bold" android:fontFeatureSettings="tnum" android:visibility="gone" />
            </LinearLayout>
            <TextView android:id="@+id/voice_widget_text" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/voice_widget_idle" android:textColor="@color/voice_widget_title"
                android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/voice_widget_detail" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="1dp"
                android:textColor="@color/voice_widget_detail" android:textSize="13sp"
                android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/voice_widget_actions" android:layout_width="match_parent"
            android:layout_height="40dp" android:layout_marginTop="2dp"
            android:orientation="horizontal" android:visibility="gone">
            <TextView android:id="@+id/voice_widget_undo" style="@style/VoiceWidgetChip"
                android:text="撤销" android:contentDescription="撤销这笔账单" />
            <TextView android:id="@+id/voice_widget_again" style="@style/VoiceWidgetChip"
                android:text="重说" android:contentDescription="放弃草稿并重新说一笔" />
            <TextView android:id="@+id/voice_widget_retry" style="@style/VoiceWidgetChip"
                android:text="重试" android:contentDescription="重新解析上次的语音内容" />
            <TextView android:id="@+id/voice_widget_from" style="@style/VoiceWidgetChip"
                android:text="换转出" android:contentDescription="切换转出账户" />
            <TextView android:id="@+id/voice_widget_to" style="@style/VoiceWidgetChip"
                android:text="换转入" android:contentDescription="切换转入账户" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="76dp" android:layout_height="wrap_content"
        android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
            <ImageButton android:id="@+id/voice_widget_button" android:layout_width="match_parent"
                android:layout_height="match_parent" android:padding="18dp" android:scaleType="fitCenter"
                android:background="@drawable/voice_widget_action_background"
                android:src="@drawable/ic_voice_widget" android:tint="@color/voice_widget_on_action"
                android:contentDescription="开始" />
            <ProgressBar android:id="@+id/voice_widget_progress" style="@style/VoiceWidgetSpinner"
                android:layout_width="36dp" android:layout_height="36dp" />
        </FrameLayout>
        <TextView android:id="@+id/voice_widget_action_label" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center"
            android:text="开始" android:textColor="@color/voice_widget_accent" android:textSize="12sp"
            android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
