<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="10dp"
    android:paddingTop="12dp" android:paddingBottom="10dp"
    android:background="@drawable/voice_widget_background">
    <LinearLayout android:id="@+id/voice_widget_body" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/voice_widget_status" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/voice_widget_hint_short" android:textColor="@color/voice_widget_accent"
                android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            <Chronometer android:id="@+id/voice_widget_timer" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:textColor="@color/voice_widget_recording" android:textSize="11sp"
                android:textStyle="bold" android:fontFeatureSettings="tnum" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/voice_widget_text" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/voice_widget_idle" android:textColor="@color/voice_widget_title"
            android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/voice_widget_detail" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="1dp"
            android:textColor="@color/voice_widget_detail" android:textSize="12sp"
            android:maxLines="2" android:ellipsize="end" android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <!-- Undo, redo and retry are never shown together, so they share one slot. -->
        <FrameLayout android:id="@+id/voice_widget_actions" android:layout_width="0dp"
            android:layout_height="40dp" android:layout_weight="1">
            <TextView android:id="@+id/voice_widget_undo" style="@style/VoiceWidgetChip"
                android:text="撤销" android:contentDescription="撤销这笔账单" />
            <TextView android:id="@+id/voice_widget_again" style="@style/VoiceWidgetChip"
                android:text="重说" android:contentDescription="放弃草稿并重新说一笔" />
            <TextView android:id="@+id/voice_widget_retry" style="@style/VoiceWidgetChip"
                android:text="重试" android:contentDescription="重新解析上次的语音内容" />
        </FrameLayout>
        <FrameLayout android:layout_width="52dp" android:layout_height="52dp">
            <ImageButton android:id="@+id/voice_widget_button" android:layout_width="match_parent"
                android:layout_height="match_parent" android:padding="14dp" android:scaleType="fitCenter"
                android:background="@drawable/voice_widget_action_background"
                android:src="@drawable/ic_voice_widget" android:tint="@color/voice_widget_on_action"
                android:contentDescription="开始" />
            <ProgressBar android:id="@+id/voice_widget_progress" style="@style/VoiceWidgetSpinner"
                android:layout_width="32dp" android:layout_height="32dp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
