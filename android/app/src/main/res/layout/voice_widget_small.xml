<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="4dp" android:background="@drawable/voice_widget_background">
    <LinearLayout android:id="@+id/voice_widget_body" android:layout_width="match_parent"
        android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
        <FrameLayout android:layout_width="46dp" android:layout_height="46dp">
            <ImageButton android:id="@+id/voice_widget_button" android:layout_width="match_parent"
                android:layout_height="match_parent" android:padding="12dp" android:scaleType="fitCenter"
                android:background="@drawable/voice_widget_action_background"
                android:src="@drawable/ic_voice_widget" android:tint="@color/voice_widget_on_action"
                android:contentDescription="开始" />
            <ProgressBar android:id="@+id/voice_widget_progress" style="@style/VoiceWidgetSpinner"
                android:layout_width="30dp" android:layout_height="30dp" />
        </FrameLayout>
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <TextView android:id="@+id/voice_widget_action_label" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="记一笔"
                android:textColor="@color/voice_widget_accent" android:textSize="11sp"
                android:textStyle="bold" android:maxLines="1" />
            <Chronometer android:id="@+id/voice_widget_timer" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/voice_widget_recording"
                android:textSize="11sp" android:textStyle="bold" android:fontFeatureSettings="tnum"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
